<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. Overrides the release config in src/main/res, which permits no cleartext at all.

  avalon-spring and ForwardAuth are served over plain http in development (see the BuildKonfig
  dev base URLs: localhost:48080 and localhost:5000). Cleartext is scoped to those hosts rather
  than enabled globally: 10.0.2.2 is the host loopback as seen from the Android emulator.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
